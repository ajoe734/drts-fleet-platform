{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "Voice Booking All-Call Metrics & Cost Ledger",
  "uid": "voice-booking-metrics-001",
  "tags": [
    "voice",
    "unattended-booking",
    "observability",
    "cost-ledger",
    "sla",
    "sa-10-2"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "type": "stat",
      "title": "全部來電覆蓋率 (All-Call Coverage)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(drts_voice_calls_entered_ai_total) / sum(drts_voice_ingress_calls_total)",
          "legendFormat": "Coverage Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "type": "stat",
      "title": "無人有效受理率 (Effective Intake Rate)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(drts_voice_valid_intakes_total) / sum(drts_voice_booking_intent_expressed_total)",
          "legendFormat": "Intake Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "type": "stat",
      "title": "無人派車完成率 (Dispatch Completion)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(drts_voice_driver_accepted_orders_total) / sum(drts_voice_immediate_dispatch_orders_total)",
          "legendFormat": "Dispatch Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "type": "stat",
      "title": "轉真人率 (Human Transfer Rate)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(drts_voice_handoff_calls_total) / sum(drts_voice_calls_entered_ai_total)",
          "legendFormat": "Transfer Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "type": "stat",
      "title": "錯單率 (Error Booking Rate)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(drts_voice_error_bookings_total) / sum(drts_voice_valid_ai_orders_total)",
          "legendFormat": "Error Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "type": "stat",
      "title": "人工回撥 SLA 達標率",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(drts_voice_callback_within_sla_total) / sum(drts_voice_callbacks_total)",
          "legendFormat": "SLA Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "type": "timeseries",
      "title": "單位通話成本與成功派車成本 (TWD)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "drts_voice_cost_per_effective_intake_twd",
          "legendFormat": "每筆有效受理成本 (TWD)"
        },
        {
          "expr": "drts_voice_cost_per_successful_dispatch_twd",
          "legendFormat": "每筆成功派車成本 (TWD, 觀察窗口結算)"
        }
      ]
    },
    {
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "type": "timeseries",
      "title": "各語言無人受理覆蓋與轉真人趨勢",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (language) (drts_voice_valid_intakes_total)",
          "legendFormat": "有效受理 - {{ language }}"
        },
        {
          "expr": "sum by (language) (drts_voice_handoff_calls_total)",
          "legendFormat": "轉接真人 - {{ language }}"
        }
      ]
    },
    {
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "type": "barchart",
      "title": "成本結構拆解 (Ledger Breakdown by Service Type)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (service_type) (drts_voice_usage_cost_twd_total)",
          "legendFormat": "{{ service_type }}"
        }
      ]
    },
    {
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "type": "table",
      "title": "活動告警 (含語言、Profile 版本與供應商維度)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\", alertname=~\"Voice.*\"}",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}