          "confirmBody": {
            "expectedRevisionNo": "{{adminRevision}}",
            "documentType": "professional_driver_license"
          }
        },
        {
          "baseUrlEnv": "DRTS_DEV_FLEET_PARTNER_PORTAL_BASE_URL",
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/{{adminSubmissionId}}",
          "method": "GET",
          "capture": {
            "adminRevision": "data.submission.revision_no"
          }
        },
        {
          "baseUrlEnv": "DRTS_DEV_FLEET_PARTNER_PORTAL_BASE_URL",
          "kind": "document-upload",
          "intentPath": "/control-plane-proxy/fleet-partner/supply-submissions/{{adminSubmissionId}}/documents/upload-url",
          "intentBody": {
            "expectedRevisionNo": "{{adminRevision}}",
            "documentType": "taxi_driver_registration"
          },
          "confirmPath": "/control-plane-proxy/fleet-partner/supply-submissions/{{adminSubmissionId}}/documents/confirm",
          "confirmBody": {
            "expectedRevisionNo": "{{adminRevision}}",
            "documentType": "taxi_driver_registration"
          }
        },
        {
          "baseUrlEnv": "DRTS_DEV_FLEET_PARTNER_PORTAL_BASE_URL",
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/{{adminSubmissionId}}",
          "method": "GET",
          "capture": {
            "adminRevision": "data.submission.revision_no"
          }
        },
        {
          "baseUrlEnv": "DRTS_DEV_FLEET_PARTNER_PORTAL_BASE_URL",
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/{{adminSubmissionId}}/submit",
          "method": "POST",
          "body": {
            "expectedRevisionNo": "{{adminRevision}}"
          }
        }
      ],
      "operations": [
        {
          "kind": "request",
          "name": "approve",
          "control": "button:has-text(\"確認核可\"), button:has-text(\"Confirm approval\")",
          "before": [
            {
              "kind": "click",
              "control": "[data-drt-operation='admin-start-review']"
            },
            {
              "kind": "click",
              "control": "[data-drt-operation='admin-approve']"
            }
          ],
          "requestUrlIncludes": "/control-plane-proxy/admin/supply-review/submissions/{{adminSubmissionId}}/approve",
