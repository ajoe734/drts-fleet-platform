          }
        }
      ],
      "operations": [
        {
          "kind": "request",
          "name": "approve",
          "control": "[data-drt-operation='admin-approve']",
          "before": [
            {
              "kind": "click",
              "control": "[data-drt-operation='admin-start-review']"
            }
          ],
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.submission_id",
          "readback": {
            "url": "/control-plane-proxy/admin/supply-review/submissions/{resultId}",
            "idPath": "data.submission.submission_id",
            "statePath": "data.submission.status",
            "expectedState": "approved"
          }
        }
      ]
    },
    {
      "id": "tenant-ops-dispatch-intent",
      "surface": "tenant-ops",
      "baseUrlEnv": "DRTS_DEV_TENANT_CONSOLE_BASE_URL",
      "route": "/bookings?q={{tenantBookingId}}",
      "actorScope": "tenant_admin",
      "browserSession": {
        "cookieName": "drts_tenant_session",
        "tokenEnv": "DRTS_OPERATIONAL_TENANT_SESSION_TOKEN",
        "templateVariable": "tenantSessionToken"
      },
      "setup": [
        {
          "baseUrlEnv": "DRTS_DEV_API_BASE_URL",
          "path": "/api/tenant/bookings",
          "method": "POST",
          "headers": {
            "authorization": "Bearer {{tenantSessionToken}}"
          },
          "body": {
            "businessDispatchSubtype": "enterprise_dispatch",
            "pickup": {
              "address": "台北信義區松仁路",
              "lat": 25.033879,
              "lng": 121.568743
            },
            "dropoff": {
              "address": "台北市政府",
              "lat": 25.03746,
              "lng": 121.564558
            },
            "reservationWindowStart": "2026-12-15T10:00:00.000Z",
            "reservationWindowEnd": "2026-12-15T11:00:00.000Z",
            "passenger": {
              "name": "Release acceptance passenger",
              "phone": "0912345678"
            }
          },
          "capture": {
            "tenantBookingId": "data.booking_id"
          }
        },
        {
          "path": "/control-plane-proxy/tenant/bookings/{{tenantBookingId}}",
          "method": "GET",
          "capture": {
            "tenantOrderId": "data.order_id"
          }
        },
        {
          "baseUrlEnv": "DRTS_DEV_API_BASE_URL",
          "path": "/api/orders/{{tenantOrderId}}/dispatch-timeout",
          "method": "POST",
          "headers": {
            "authorization": "Bearer {{tenantSessionToken}}"
          },
          "body": {
            "timeoutReasonCode": "acceptance_timeout"
          }
        }
      ],
      "operations": [
        {
          "kind": "intent",
          "name": "open-ops-dispatch",
          "control": "[data-drt-intent='tenant-open-dispatch']",
          "targetBaseUrlEnv": "DRTS_DEV_OPS_CONSOLE_BASE_URL",
          "expectedPathPattern": "^/dispatch/[^/?#]+$"
        }
      ]
    },
    {
      "id": "bank-statement-download",
      "surface": "bank",
      "baseUrlEnv": "DRTS_DEV_BANK_CONSOLE_BASE_URL",
      "route": "/statements?bank=ctbc&locale=zh&role=bank_program_admin",
      "actorScope": "bank_program_admin",
      "setup": [
        {
          "path": "/api/auth/login",
          "method": "POST",
          "body": {
            "bank": "ctbc",
            "locale": "zh",
            "role": "bank_program_admin"
          }
        }
      ],
      "operations": [
        {
          "kind": "request",
          "name": "download",
          "control": "[data-drt-operation='bank-statement-download']",
          "requestUrlIncludes": "/artifacts/statements/",
          "requestMethod": "GET",
          "responseKind": "download",
          "expectedContentTypeIncludes": "text/plain"
        }
      ]
    },
    {
      "id": "channel-statement-download",
      "surface": "channel",
      "baseUrlEnv": "DRTS_DEV_CHANNEL_PARTNER_PORTAL_BASE_URL",
      "route": "/statements",
      "actorScope": "channel partner",
      "operations": [
        {
          "kind": "request",
          "name": "download",
          "control": "[data-drt-operation='channel-statement-download']",
          "before": [
            {
              "kind": "click",
              "control": "[data-drt-intent='channel-statement-detail']"
            }
          ],
          "requestUrlIncludes": "/control-plane-proxy/partner/referral/statements/",
          "requestMethod": "GET",
          "responseKind": "download",
          "expectedContentTypeIncludes": "text/csv"
        }
      ]
    }
  ],
  "retiredSurfaces": [
