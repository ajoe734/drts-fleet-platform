{
  "$schema": "https://drts.local/schemas/operational-browser-journeys.v2.json",
  "version": 2,
  "candidateSha": "__SET_DRTS_CANDIDATE_SHA__",
  "journeys": [
    {
      "id": "referral-create-read-cancel-rate-receipt",
      "surface": "referral",
      "baseUrlEnv": "DRTS_DEV_REFERRAL_EMBED_BASE_URL",
      "route": "/embed/yuhe-residence?screen=book",
      "actorScope": "partner-scoped referral passenger",
      "setup": [
        {
          "path": "/api/referral/session",
          "method": "POST",
          "body": {
            "action": "demo-bootstrap",
            "entrySlug": "yuhe-residence",
            "entryHost": "app.yuhe-living.com.tw"
          }
        }
      ],
      "operations": [
        {
          "kind": "request",
          "name": "create",
          "control": "[data-drt-operation='referral-create']",
          "before": [
            {
              "kind": "fill",
              "control": "input[name='pickupAddress']",
              "value": "台北車站"
            },
            {
              "kind": "fill",
              "control": "input[name='dropoffAddress']",
              "value": "桃園國際機場 T2"
            }
          ],
          "requestUrlIncludes": "/api/referral/booking",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.orderId",
          "resultIdQueryParam": "orderId",
          "readback": {
            "url": "/api/referral/history/{resultId}",
            "idPath": "data.orderId",
            "statePath": "data.status",
            "expectedState": "CONFIRMED"
          }
        },
        {
          "kind": "request",
          "name": "cancel",
          "control": "[data-drt-operation='referral-cancel']",
          "requestUrlIncludes": "/api/referral/cancel",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.orderId",
          "resultIdQueryParam": "orderId",
          "readback": {
            "url": "/api/referral/history/{resultId}",
            "idPath": "data.orderId",
            "statePath": "data.status",
            "expectedState": "CANCELLED"
          }
        },
        {
          "kind": "request",
          "name": "rate",
          "control": "[data-drt-operation='referral-rate']",
          "requestUrlIncludes": "/api/referral/rating",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.orderId",
          "readback": {
            "url": "/api/referral/history/{resultId}",
            "idPath": "data.orderId",
            "statePath": "data.status",
            "expectedState": "CANCELLED"
          }
        },
        {
          "kind": "navigation",
          "name": "receipt",
          "control": "[data-drt-operation='referral-receipt']",
          "expectedPath": "/embed/yuhe-residence",
          "expectedQuery": {
            "screen": "receipt",
            "orderId": "{resultId}"
          },
          "readback": {
            "url": "/api/referral/receipt/{resultId}",
            "idPath": "data.orderId",
            "statePath": "data.status",
            "expectedState": "CANCELLED"
          }
        }
      ]
    },
    {
      "id": "enterprise-create-read-update-cancel",
      "surface": "enterprise",
      "baseUrlEnv": "DRTS_DEV_ENTERPRISE_DISPATCH_BASE_URL",
      "route": "/bookings/new",
      "actorScope": "tenant_admin",
      "operations": [
        {
          "kind": "request",
          "name": "create",
          "control": "[data-drt-operation='enterprise-create']",
          "before": [
            {
              "kind": "click",
              "control": "[data-drt-intent='enterprise-review']"
            }
          ],
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.booking_id",
          "readback": {
            "url": "/control-plane-proxy/tenant/bookings/{resultId}",
            "idPath": "data.booking_id",
            "statePath": "data.order_status",
            "expectedState": "created"
          }
        },
        {
          "kind": "request",
          "name": "update",
          "control": "[data-drt-operation='enterprise-update']",
          "before": [
            {
              "kind": "navigate",
              "path": "/bookings/new?bookingId={resultId}"
            },
            {
              "kind": "click",
              "control": "[data-drt-intent='enterprise-review']"
            }
          ],
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "PUT",
          "responseKind": "json",
          "resultIdPath": "data.booking_id",
          "readback": {
            "url": "/control-plane-proxy/tenant/bookings/{resultId}",
            "idPath": "data.booking_id",
            "statePath": "data.order_status",
            "expectedState": "created"
          }
        },
        {
          "kind": "request",
          "name": "cancel",
          "control": "[data-drt-operation='enterprise-cancel']",
          "before": [{ "kind": "navigate", "path": "/bookings/{resultId}" }],
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.booking_id",
          "readback": {
            "url": "/control-plane-proxy/tenant/bookings/{resultId}",
            "idPath": "data.booking_id",
            "statePath": "data.order_status",
            "expectedState": "cancelled"
          }
        }
      ]
    },
    {
      "id": "fleet-submit-read-withdraw-resubmit",
      "surface": "fleet",
      "baseUrlEnv": "DRTS_DEV_FLEET_PARTNER_PORTAL_BASE_URL",
      "route": "/supply/submissions/{{fleetSubmissionId}}",
      "actorScope": "fleet partner",
      "setup": [
        {
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/drivers",
          "method": "POST",
          "body": {
            "name": "Release acceptance driver",
            "mobile": "0912345678",
            "professionalDriverLicenseNo": "ACC-PDL-{{runId}}",
            "professionalDriverLicenseExpiry": "2029-12-31",
            "taxiDriverRegistrationNo": "ACC-TAXI-{{runId}}",
            "taxiDriverRegistrationArea": "taipei",
            "taxiDriverRegistrationExpiry": "2029-12-31",
            "supportedServiceProductCodes": ["enterprise_dispatch"],
            "preferredVehicleSubmissionId": null
          },
          "capture": {
            "fleetSubmissionId": "data.submission.submission_id",
            "fleetRevision": "data.submission.revision_no"
          }
        },
        {
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/{{fleetSubmissionId}}/documents/upload-url",
          "method": "POST",
          "body": {
            "expectedRevisionNo": "{{fleetRevision}}",
            "documentType": "professional_driver_license",
            "originalFileName": "professional-driver-license.txt",
            "contentType": "text/plain"
          },
          "capture": {
            "fleetLicenseObjectKey": "data.object_key"
          }
        },
        {
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/{{fleetSubmissionId}}/documents/confirm",
          "method": "POST",
          "body": {
            "expectedRevisionNo": "{{fleetRevision}}",
            "documentType": "professional_driver_license",
            "objectKey": "{{fleetLicenseObjectKey}}",
            "originalFileName": "professional-driver-license.txt",
            "contentType": "text/plain",
            "fileSize": 1,
            "checksumSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        },
        {
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/{{fleetSubmissionId}}",
          "method": "GET",
          "capture": {
            "fleetRevision": "data.submission.revision_no"
          }
        },
        {
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/{{fleetSubmissionId}}/documents/upload-url",
          "method": "POST",
          "body": {
            "expectedRevisionNo": "{{fleetRevision}}",
            "documentType": "taxi_driver_registration",
            "originalFileName": "taxi-driver-registration.txt",
            "contentType": "text/plain"
          },
          "capture": {
            "fleetRegistrationObjectKey": "data.object_key"
          }
        },
        {
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/{{fleetSubmissionId}}/documents/confirm",
          "method": "POST",
          "body": {
            "expectedRevisionNo": "{{fleetRevision}}",
            "documentType": "taxi_driver_registration",
            "objectKey": "{{fleetRegistrationObjectKey}}",
            "originalFileName": "taxi-driver-registration.txt",
            "contentType": "text/plain",
            "fileSize": 1,
            "checksumSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          }
        }
      ],
      "operations": [
        {
          "kind": "request",
          "name": "submit",
          "control": "[data-drt-operation='fleet-submit']",
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.submission.submission_id",
          "readback": {
            "url": "/control-plane-proxy/fleet-partner/supply-submissions/{resultId}",
            "idPath": "data.submission.submission_id",
            "statePath": "data.submission.status",
            "expectedState": "submitted"
          }
        },
        {
          "kind": "request",
          "name": "withdraw",
          "control": "[data-drt-operation='fleet-withdraw']",
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.submission.submission_id",
          "readback": {
            "url": "/control-plane-proxy/fleet-partner/supply-submissions/{resultId}",
            "idPath": "data.submission.submission_id",
            "statePath": "data.submission.status",
            "expectedState": "withdrawn"
          }
        },
        {
          "kind": "request",
          "name": "resubmit",
          "control": "[data-drt-operation='fleet-resubmit']",
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.submission.submission_id",
          "readback": {
            "url": "/control-plane-proxy/fleet-partner/supply-submissions/{resultId}",
            "idPath": "data.submission.submission_id",
            "statePath": "data.submission.status",
            "expectedState": "submitted"
          }
        }
      ]
    },
    {
