    {
      "id": "tenant-ops-dispatch-intent",
      "surface": "tenant-ops",
      "baseUrlEnv": "DRTS_DEV_TENANT_CONSOLE_BASE_URL",
      "route": "/bookings?q={{tenantBookingId}}",
      "actorScope": "tenant_admin",
      "environmentVariables": {
        "dispatchSessionToken": "DRTS_OPERATIONAL_DISPATCH_SESSION_TOKEN"
      },
      "browserSession": {
        "cookieName": "drts_tenant_session",
        "tokenEnv": "DRTS_OPERATIONAL_TENANT_SESSION_TOKEN",
        "templateVariable": "tenantSessionToken"
      },
      "setup": [
        {
          "baseUrlEnv": "DRTS_DEV_API_BASE_URL",
          "path": "/api/tenant/bookings",
          "method": "POST",
          "headers": {
            "authorization": "Bearer {{tenantSessionToken}}",
            "x-tenant-id": "10000000-0000-0000-0000-000000000201",
            "idempotency-key": "operational-create-{{runId}}"
          },
          "body": {
            "businessDispatchSubtype": "enterprise_dispatch",
            "pickup": {
              "address": "台北信義區松仁路",
              "lat": 25.033879,
              "lng": 121.568743
            },
            "dropoff": {
              "address": "台北市政府",
              "lat": 25.03746,
              "lng": 121.564558
            },
            "reservationWindowStart": "2026-12-15T10:00:00.000Z",
            "reservationWindowEnd": "2026-12-15T11:00:00.000Z",
            "passenger": {
              "name": "Release acceptance passenger",
              "phone": "0912345678"
            }
          },
          "capture": {
            "tenantBookingId": "data.booking_id"
          }
        },
        {
          "path": "/control-plane-proxy/tenant/bookings/{{tenantBookingId}}",
          "method": "GET",
          "capture": {
            "tenantOrderId": "data.order_id"
          }
        },
        {
          "baseUrlEnv": "DRTS_DEV_API_BASE_URL",
          "path": "/api/orders/{{tenantOrderId}}/dispatch-timeout",
          "method": "POST",
          "headers": {
            "authorization": "Bearer {{dispatchSessionToken}}",
            "x-tenant-id": "10000000-0000-0000-0000-000000000201",
            "idempotency-key": "operational-dispatch-timeout-{{runId}}"
          },
          "body": {
            "timeoutReasonCode": "matching_timeout"
          }
        }
      ],
      "operations": [
        {
          "kind": "intent",
          "name": "open-ops-dispatch",
          "control": "[data-drt-intent='tenant-open-dispatch']",
          "targetBaseUrlEnv": "DRTS_DEV_OPS_CONSOLE_BASE_URL",
          "expectedPathPattern": "^/dispatch/[^/?#]+$"
        }
      ]
    },
