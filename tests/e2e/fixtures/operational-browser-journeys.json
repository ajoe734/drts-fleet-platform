      "baseUrlEnv": "DRTS_DEV_PLATFORM_ADMIN_BASE_URL",
      "route": "/supply-review/{{adminSubmissionId}}",
      "actorScope": "platform_admin",
      "setup": [
        {
          "baseUrlEnv": "DRTS_DEV_FLEET_PARTNER_PORTAL_BASE_URL",
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/drivers",
          "method": "POST",
          "body": {
            "name": "Release admin review driver",
            "mobile": "0912345678",
            "professionalDriverLicenseNo": "ACC-ADMIN-PDL-{{runId}}",
            "professionalDriverLicenseExpiry": "2029-12-31",
            "taxiDriverRegistrationNo": "ACC-ADMIN-TAXI-{{runId}}",
            "taxiDriverRegistrationArea": "taipei",
            "taxiDriverRegistrationExpiry": "2029-12-31",
            "supportedServiceProductCodes": ["enterprise_dispatch"],
            "preferredVehicleSubmissionId": null
          },
          "capture": {
            "adminSubmissionId": "data.submission.submission_id",
            "adminRevision": "data.submission.revision_no"
          }
        },
        {
          "baseUrlEnv": "DRTS_DEV_FLEET_PARTNER_PORTAL_BASE_URL",
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/{{adminSubmissionId}}/documents/upload-url",
          "method": "POST",
          "body": {
            "expectedRevisionNo": "{{adminRevision}}",
            "documentType": "professional_driver_license",
