          "body": {
            "expectedRevisionNo": "{{adminRevision}}",
            "documentType": "professional_driver_license",
            "objectKey": "{{adminLicenseObjectKey}}",
            "originalFileName": "admin-professional-driver-license.txt",
            "contentType": "text/plain",
            "fileSize": 1,
            "checksumSha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
