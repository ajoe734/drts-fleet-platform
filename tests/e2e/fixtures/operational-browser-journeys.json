{
  "$schema": "https://drts.local/schemas/operational-browser-journeys.v2.json",
  "version": 2,
  "candidateSha": "__SET_DRTS_CANDIDATE_SHA__",
  "journeys": [
    {
      "id": "referral-create-read-cancel-rate-receipt",
      "surface": "referral",
      "baseUrlEnv": "DRTS_DEV_REFERRAL_EMBED_BASE_URL",
      "route": "/embed/yuhe-residence?screen=book",
      "actorScope": "partner-scoped referral passenger",
      "setup": [
        {
          "path": "/api/referral/session",
          "method": "POST",
          "body": {
            "action": "demo-bootstrap",
            "entrySlug": "yuhe-residence",
            "entryHost": "app.yuhe-living.com.tw"
          }
        }
      ],
      "operations": [
        {
          "kind": "request",
          "name": "create",
          "control": "[data-drt-operation='referral-create']",
          "requestUrlIncludes": "/api/referral/booking",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.orderId",
          "readback": {
            "url": "/api/referral/history/{resultId}",
            "idPath": "data.orderId",
            "statePath": "data.status",
            "expectedState": "CONFIRMED"
          }
        },
        {
          "kind": "request",
          "name": "cancel",
          "control": "[data-drt-operation='referral-cancel']",
          "requestUrlIncludes": "/api/referral/cancel",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.orderId",
          "readback": {
            "url": "/api/referral/history/{resultId}",
            "idPath": "data.orderId",
            "statePath": "data.status",
            "expectedState": "CANCELLED"
          }
        },
        {
          "kind": "request",
          "name": "rate",
          "control": "[data-drt-operation='referral-rate']",
          "requestUrlIncludes": "/api/referral/rating",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.orderId",
          "readback": {
            "url": "/api/referral/history/{resultId}",
            "idPath": "data.orderId",
            "statePath": "data.status",
            "expectedState": "CANCELLED"
          }
        },
        {
          "kind": "request",
          "name": "receipt",
          "control": "[data-drt-operation='referral-receipt']",
          "requestUrlIncludes": "/api/referral/receipt",
          "requestMethod": "GET",
          "responseKind": "json",
          "resultIdPath": "data.orderId",
          "readback": {
            "url": "/api/referral/receipt/{resultId}",
            "idPath": "data.orderId",
            "statePath": "data.status",
            "expectedState": "CANCELLED"
          }
        }
      ]
    },
    {
      "id": "enterprise-create-read-update-cancel",
      "surface": "enterprise",
      "baseUrlEnv": "DRTS_DEV_ENTERPRISE_DISPATCH_BASE_URL",
      "route": "/bookings/new",
      "actorScope": "tenant_admin",
      "operations": [
        {
          "kind": "request",
          "name": "create",
          "control": "[data-drt-operation='enterprise-create']",
          "before": [
            {
              "kind": "click",
              "control": "[data-drt-intent='enterprise-review']"
            }
          ],
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.id",
          "readback": {
            "url": "/control-plane-proxy/bookings/{resultId}",
            "idPath": "data.id",
            "statePath": "data.status",
            "expectedState": "PENDING"
          }
        },
        {
          "kind": "request",
          "name": "update",
          "control": "[data-drt-operation='enterprise-update']",
          "before": [
            {
              "kind": "navigate",
              "path": "/bookings/new?bookingId={resultId}"
            },
            {
              "kind": "click",
              "control": "[data-drt-intent='enterprise-review']"
            }
          ],
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "PUT",
          "responseKind": "json",
          "resultIdPath": "data.id",
          "readback": {
            "url": "/control-plane-proxy/bookings/{resultId}",
            "idPath": "data.id",
            "statePath": "data.status",
            "expectedState": "PENDING"
          }
        },
        {
          "kind": "request",
          "name": "cancel",
          "control": "[data-drt-operation='enterprise-cancel']",
          "before": [{ "kind": "navigate", "path": "/bookings/{resultId}" }],
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.id",
          "readback": {
            "url": "/control-plane-proxy/bookings/{resultId}",
            "idPath": "data.id",
            "statePath": "data.status",
            "expectedState": "CANCELLED"
          }
        }
      ]
    },
    {
      "id": "fleet-submit-read-withdraw-resubmit",
      "surface": "fleet",
      "baseUrlEnv": "DRTS_DEV_FLEET_PARTNER_PORTAL_BASE_URL",
      "route": "/supply/submissions/sub_d41",
      "actorScope": "fleet partner",
      "operations": [
        {
          "kind": "request",
          "name": "submit",
          "control": "[data-drt-operation='fleet-submit']",
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.submission.submissionId",
          "readback": {
            "url": "/control-plane-proxy/fleet-partner/supply-submissions/{resultId}",
            "idPath": "data.submission.submissionId",
            "statePath": "data.submission.status",
            "expectedState": "submitted"
          }
        },
        {
          "kind": "request",
          "name": "withdraw",
          "control": "[data-drt-operation='fleet-withdraw']",
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.submission.submissionId",
          "readback": {
            "url": "/control-plane-proxy/fleet-partner/supply-submissions/{resultId}",
            "idPath": "data.submission.submissionId",
            "statePath": "data.submission.status",
            "expectedState": "withdrawn"
          }
        },
        {
          "kind": "request",
          "name": "resubmit",
          "control": "[data-drt-operation='fleet-resubmit']",
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.submission.submissionId",
          "readback": {
            "url": "/control-plane-proxy/fleet-partner/supply-submissions/{resultId}",
            "idPath": "data.submission.submissionId",
            "statePath": "data.submission.status",
            "expectedState": "submitted"
          }
        }
      ]
    },
    {
      "id": "admin-review-approve-readback",
      "surface": "platform-admin",
      "baseUrlEnv": "DRTS_DEV_PLATFORM_ADMIN_BASE_URL",
      "route": "/supply-review/sub_s38",
      "actorScope": "platform_admin",
      "operations": [
        {
          "kind": "request",
          "name": "approve",
          "control": "[data-drt-operation='admin-approve']",
          "requestUrlIncludes": "/control-plane-proxy/",
          "requestMethod": "POST",
          "responseKind": "json",
          "resultIdPath": "data.submissionId",
          "readback": {
            "url": "/control-plane-proxy/admin/supply-review/submissions/{resultId}",
            "idPath": "data.submission.submissionId",
            "statePath": "data.submission.status",
            "expectedState": "approved"
          }
        }
      ]
    },
    {
      "id": "tenant-ops-dispatch-intent",
      "surface": "tenant-ops",
      "baseUrlEnv": "DRTS_DEV_TENANT_CONSOLE_BASE_URL",
      "route": "/bookings",
      "actorScope": "tenant_admin",
      "operations": [
        {
          "kind": "intent",
          "name": "open-ops-dispatch",
          "control": "[data-drt-intent='tenant-open-dispatch']",
          "targetBaseUrlEnv": "DRTS_DEV_OPS_CONSOLE_BASE_URL",
          "expectedPathPattern": "^/dispatch/[^/?#]+$"
        }
      ]
    },
    {
      "id": "bank-statement-download",
      "surface": "bank",
      "baseUrlEnv": "DRTS_DEV_BANK_CONSOLE_BASE_URL",
      "route": "/statements?bank=ctbc&locale=zh&role=bank_program_admin",
      "actorScope": "bank_program_admin",
      "setup": [
        {
          "path": "/api/auth/login",
          "method": "POST",
          "body": {
            "bank": "ctbc",
            "locale": "zh",
            "role": "bank_program_admin"
          }
        }
      ],
      "operations": [
        {
          "kind": "request",
          "name": "download",
          "control": "[data-drt-operation='bank-statement-download']",
          "requestUrlIncludes": "/artifacts/statements/",
          "requestMethod": "GET",
          "responseKind": "download",
          "expectedContentTypeIncludes": "text/plain"
        }
      ]
    },
    {
      "id": "channel-statement-download",
      "surface": "channel",
      "baseUrlEnv": "DRTS_DEV_CHANNEL_PARTNER_PORTAL_BASE_URL",
      "route": "/statements",
      "actorScope": "channel partner",
      "operations": [
        {
          "kind": "request",
          "name": "download",
          "control": "[data-drt-operation='channel-statement-download']",
          "before": [
            {
              "kind": "click",
              "control": "[data-drt-intent='channel-statement-detail']"
            }
          ],
          "requestUrlIncludes": "/control-plane-proxy/partner/referral/statements/",
          "requestMethod": "GET",
          "responseKind": "download",
          "expectedContentTypeIncludes": "text/csv"
        }
      ]
    }
  ],
  "retiredSurfaces": [
    {
      "id": "partner-booking-site",
      "baseUrlEnv": "DRTS_DEV_PARTNER_BOOKING_BASE_URL",
      "path": "/ctbc/program/site"
    },
    {
      "id": "partner-booking-embed",
      "baseUrlEnv": "DRTS_DEV_PARTNER_BOOKING_BASE_URL",
      "path": "/ctbc/program/embed"
    },
    {
      "id": "concierge",
      "baseUrlEnv": "DRTS_DEV_CONCIERGE_BASE_URL",
      "path": "/"
    }
  ]
}
