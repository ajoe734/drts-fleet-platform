          },
          "capture": {
            "adminRegistrationObjectKey": "data.object_key"
          }
        },
        {
          "baseUrlEnv": "DRTS_DEV_FLEET_PARTNER_PORTAL_BASE_URL",
          "path": "/control-plane-proxy/fleet-partner/supply-submissions/{{adminSubmissionId}}/documents/confirm",
          "method": "POST",
          "body": {
            "expectedRevisionNo": "{{adminRevision}}",
            "documentType": "taxi_driver_registration",
            "objectKey": "{{adminRegistrationObjectKey}}",
            "originalFileName": "admin-taxi-driver-registration.txt",
            "contentType": "text/plain",
            "fileSize": 1,
