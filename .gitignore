# orchestrator runtime
# config.json is per-machine runtime state, derived from
# tools/development-orchestrator/config/config.example.json. It was tracked, so
# which branch the canonical root sat on silently changed the live fleet's
# configuration -- and switching to a branch that lacked it deleted the running
# supervisor's config outright. Runtime state does not belong in git; the
# example file is what gets shared.
.orchestrator/config.json
.llm-inbox/
.orchestrator/bin/
.orchestrator/logs/
.orchestrator/supervisor.pid
.orchestrator/event-queue.jsonl
.orchestrator/approval-queue.json
.orchestrator/github-bus-state.json
.orchestrator/github-webhook-events.jsonl
.orchestrator/github-relay-state.json
.orchestrator/approval-queue.lock
.orchestrator/backups/
.orchestrator/claude-approval-broker.mcp.json
.orchestrator/provider_capabilities.json
.orchestrator/antigravity-rotation.json
.orchestrator/state.json
.orchestrator/.state.json.*.tmp
.orchestrator/chair-reviews/
.orchestrator/evidence/
.orchestrator/generated/
tools/development-orchestrator/dashboard/approval-queue.json
tools/development-orchestrator/dashboard/ai-activity-log.jsonl
tools/development-orchestrator/dashboard/ai-status.json
tools/development-orchestrator/dashboard/current-work.md
tools/development-orchestrator/dashboard/orchestrator-state.json
docs/03-runbooks/local-development.local.md
.local/
.orchestrator/state-digest.json

# Runtime task registry / human summary — regenerated by the supervisor,
# mirrored to the development dashboard via sync_docs_site(); never branch-versioned (was the
# root cause of the 2026-05-26 canonical-root task-visibility incident).
/ai-status.json
/current-work.md

# Dotted runtime variants of the above — the supervisor now writes hidden
# (leading-dot) status/activity files plus their atomic .tmp and flock .lock
# siblings; the non-dotted rules above don't match these, so they leaked into
# `git status`. Ignore the whole families.
.ai-status.json
.ai-status.json.*
.ai-activity-log.jsonl
.ai-activity-log.jsonl.*
.orchestrator/.event-queue.jsonl
.orchestrator/.event-queue.jsonl.*
.orchestrator/*.lock

# Canonical-root runtime state and local development artifacts are not source.
.orchestrator/*
.artifacts/
workspace/
tmp_iam_acc3_fix/
.ai-task-archive.jsonl.lock
