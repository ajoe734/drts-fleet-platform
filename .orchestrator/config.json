{
  "paths": {
    "status_file": "ai-status.json",
    "activity_log": "ai-activity-log.jsonl",
    "current_work": "current-work.md",
    "dashboard": "tools/development-orchestrator/dashboard/index.html",
    "state_file": ".orchestrator/state.json",
    "event_queue": ".orchestrator/event-queue.jsonl",
    "approval_queue": ".orchestrator/approval-queue.json",
    "github_bus_state": ".orchestrator/github-bus-state.json",
    "provider_capabilities": ".orchestrator/provider_capabilities.json",
    "control_plane_summary": ".orchestrator/projections/control-plane-summary.json",
    "antigravity_rotation": ".orchestrator/antigravity-rotation.json",
    "claude_mcp_config": ".orchestrator/claude-approval-broker.mcp.json"
  },
  "watcher": {
    "poll_interval_seconds": 2.0,
    "replay_on_start": false,
    "max_seen_events": 2000
  },
  "supervisor": {
    "poll_interval_seconds": 2.0,
    "heartbeat_warn_after_seconds": 10.0,
    "stall_after_seconds": 300,
    "max_worker_history": 200,
    "auto_refresh_provider_capabilities": false,
    "worker_units": {
      "profiles": {
        "execution": { "memory_high": "4G", "memory_max": "5G" },
        "heavy": { "memory_high": "5G", "memory_max": "6G" },
        "control": { "memory_high": "1G", "memory_max": "2G" }
      }
    },
    "resource_guard": {
      "enabled": true,
      "max_total_workers": 12,
      "max_execution_workers": 12,
      "max_control_workers": 1,
      "max_heavy_workers": 1,
      "dispatch_memory_high_bytes": 2684354560,
      "dispatch_pressure_avg10": 60.0
    },
    "worker_workspace_cleanup": {
      "enabled": true,
      "archive_dirty_worktrees": true,
      "force_remove_dirty_worktrees_after_archive": true
    },
    "disk_guard": {
      "enabled": true,
      "path": ".",
      "warn_usage_percent": 80,
      "cleanup_usage_percent": 85,
      "block_dispatch_usage_percent": 85,
      "min_free_gb": 5,
      "cleanup_interval_seconds": 3600,
      "worktree_retention_days": 3,
      "max_worktrees_removed_per_tick": 200,
      "remove_dirty_worktrees": false
    }
  },
  "worker_retry": {
    "enabled": true,
    "max_attempts": 5,
    "backoff_schedule_seconds": [5, 15, 30, 60, 120],
    "jitter_seconds": 3,
    "transient_error_patterns": [
      "429",
      "resource_exhausted",
      "rate limit",
      "rate limited",
      "timed out",
      "etimedout",
      "econnreset",
      "temporarily unavailable",
      "try again later",
      "server overloaded",
      "deadline exceeded",
      "terminalquotaerror",
      "retryablequotaerror",
      "quota_exhausted",
      "quota exhausted",
      "exhausted your capacity",
      "no capacity available for model"
    ],
    "fallback_mode": "file_inbox"
  },
  "worker_reassignment": {
    "enabled": true,
    "after_attempts": 2,
    "reassign_on_terminal_failure": true,
    "eligible_statuses": ["backlog", "todo", "in_progress", "review"],
    "owner_fallbacks": {
      "Claude": ["Gemini", "Gemini2", "Claude2", "Codex", "Codex2", "Copilot"],
      "Claude2": ["Gemini", "Gemini2", "Claude", "Codex", "Codex2", "Copilot"],
      "Gemini": ["Gemini2", "Codex", "Codex2", "Claude", "Claude2", "Copilot"],
      "Gemini2": ["Gemini", "Codex", "Codex2", "Claude", "Claude2", "Copilot"],
      "Codex": ["Gemini", "Gemini2", "Codex2", "Claude2", "Claude", "Copilot"],
      "Codex2": ["Gemini", "Gemini2", "Codex", "Claude2", "Claude", "Copilot"],
      "Copilot": ["Gemini", "Gemini2", "Codex", "Codex2", "Claude2", "Claude"]
    },
    "reviewer_fallbacks": {
      "Claude": ["Gemini", "Gemini2", "Claude2", "Codex", "Codex2", "Copilot"],
      "Claude2": ["Gemini", "Gemini2", "Claude", "Codex", "Codex2", "Copilot"],
      "Gemini": ["Gemini2", "Codex", "Codex2", "Claude", "Claude2", "Copilot"],
      "Gemini2": ["Gemini", "Codex", "Codex2", "Claude", "Claude2", "Copilot"],
      "Codex": ["Gemini", "Gemini2", "Codex2", "Claude2", "Claude", "Copilot"],
      "Codex2": ["Gemini", "Gemini2", "Codex", "Claude2", "Claude", "Copilot"],
      "Copilot": ["Gemini", "Gemini2", "Codex", "Codex2", "Claude2", "Claude"]
    }
  },
  "chair_review": {
    "enabled": true,
    "cooldown_seconds": 900,
    "failure_streak_threshold": 2,
    "default_approval_ttl_minutes": 45
  },
  "approvals": {
    "stale_pending_seconds": 1800
  },
  "github_bus": {
    "enabled": true,
    "command_timeout_seconds": 8,
    "poll_interval_seconds": 30,
    "repo": null,
    "default_branch": "dev",
    "offline_backoff_seconds": 300,
    "auto_request_reviewers": false,
    "candidate_reconcile_enabled": true,
    "auto_merge": {
      "enabled": true
    },
    "close_resolved_issues": false,
    "labels": {
      "review": ["pantheon-bus", "pantheon-review"],
      "ops": ["pantheon-bus", "pantheon-ops", "approval-needed"],
      "resolved": ["resolved"]
    },
    "commands": [
      "/approve",
      "/deny",
      "/retry",
      "/resume",
      "/recheck",
      "/status"
    ],
    "reviewers": {
      "Claude": ["your-github-handle"],
      "Claude2": ["your-github-handle"],
      "Gemini": ["your-github-handle"],
      "Gemini2": ["your-github-handle"],
      "Codex": ["your-github-handle"],
      "Copilot": ["your-github-handle"]
    },
    "templates": {
      "ops_issue": "tools/development-orchestrator/templates/github_ops_issue.md",
      "review_pr": "tools/development-orchestrator/templates/github_review_pr.md"
    }
  },
  "schema": {
    "tasks_path": "tasks",
    "handoffs_path": "handoffs",
    "task_id_field": "id",
    "status_field": "status",
    "assignee_field": "owner",
    "reviewer_field": "reviewer",
    "artifacts_field": "artifacts",
    "next_field": "next",
    "last_update_field": "last_update"
  },
  "events": {
    "enqueue_runtime_events": false,
    "review_statuses": ["review"],
    "status_targets": {
      "needs_reply": "owner",
      "needs_input": "owner",
      "handoff": "owner"
    },
    "waiting_status_patterns": ["^waiting_on_(?P<agent>[A-Za-z0-9_-]+)$"],
    "watch_assignee_changes": false,
    "watch_reviewer_changes": false,
    "watch_handoffs": false,
    "pending_handoff_statuses": ["pending"]
  },
  "agents": {
    "claude": {
      "display_name": "Claude",
      "provider": "claude",
      "adapter": "claude_cli",
      "wake_template": "tools/development-orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/claude.md"
    },
    "gemini": {
      "display_name": "Gemini",
      "provider": "gemini",
      "adapter": "antigravity",
      "wake_template": "tools/development-orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/gemini.md"
    },
    "claude2": {
      "display_name": "Claude2",
      "provider": "claude2",
      "adapter": "claude_cli",
      "wake_template": "tools/development-orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/claude2.md"
    },
    "gemini2": {
      "display_name": "Gemini2",
      "provider": "gemini2",
      "adapter": "antigravity",
      "wake_template": "tools/development-orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/gemini2.md"
    },
    "codex": {
      "display_name": "Codex",
      "provider": "codex",
      "adapter": "codex",
      "wake_template": "tools/development-orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/codex.md"
    },
    "codex2": {
      "display_name": "Codex2",
      "provider": "codex2",
      "adapter": "codex",
      "wake_template": "tools/development-orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/codex2.md"
    },
    "copilot": {
      "display_name": "Copilot",
      "provider": "copilot",
      "adapter": "copilot_local",
      "wake_template": "tools/development-orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/copilot.md"
    }
  },
  "providers": {
    "claude": {
      "delivery_mode": "claude_cli",
      "file_inbox": {
        "path": ".llm-inbox/claude.md",
        "open_in_vscode": false
      },
      "runtime": {
        "cli": "claude",
        "model": "claude-sonnet-5",
        "output_format": "stream-json",
        "include_hook_events": true,
        "permission_mode": "acceptEdits",
        "resume_permission_mode_after_approval": "acceptEdits",
        "resume_use_allowed_tools_from_approval": true,
        "enable_auto_mode_if_supported": true,
        "auto_permission_mode": "auto",
        "mcp_config": ".orchestrator/claude-approval-broker.mcp.json",
        "permission_prompt_tool": "mcp__orchestrator_approval_broker__approval_prompt"
      },
      "broker": {
        "approval_wait_seconds": 3600,
        "http_host": "127.0.0.1",
        "http_port": 8765,
        "persist_allow_by_default": false
      },
      "approval": {
        "workspace_permission_mode": "acceptEdits",
        "allow_dangerous_skip": false,
        "copilot_allow_dangerous_skip": false,
        "rule_default_mode": "acceptEdits",
        "disable_bypass_permissions": true
      }
    },
    "claude2": {
      "delivery_mode": "claude_cli",
      "file_inbox": {
        "path": ".llm-inbox/claude2.md",
        "open_in_vscode": false
      },
      "runtime": {
        "cli": "claude",
        "model": "claude-sonnet-5",
        "output_format": "stream-json",
        "include_hook_events": true,
        "permission_mode": "acceptEdits",
        "resume_permission_mode_after_approval": "acceptEdits",
        "resume_use_allowed_tools_from_approval": true,
        "enable_auto_mode_if_supported": true,
        "auto_permission_mode": "auto",
        "mcp_config": ".orchestrator/claude-approval-broker.mcp.json",
        "permission_prompt_tool": "mcp__orchestrator_approval_broker__approval_prompt"
      },
      "broker": {
        "approval_wait_seconds": 3600,
        "http_host": "127.0.0.1",
        "http_port": 8765,
        "persist_allow_by_default": false
      },
      "approval": {
        "workspace_permission_mode": "acceptEdits",
        "allow_dangerous_skip": false,
        "copilot_allow_dangerous_skip": false,
        "rule_default_mode": "acceptEdits",
        "disable_bypass_permissions": true
      }
    },
    "gemini": {
      "delivery_mode": "gemini",
      "file_inbox": {
        "path": ".llm-inbox/gemini.md",
        "open_in_vscode": false
      },
      "gemini": {
        "cli": "gemini",
        "env": {
          "GEMINI_CLI_TRUST_WORKSPACE": "true"
        },
        "include_directories": true,
        "skip_trust": true,
        "allowed_tools": ["run_shell_command"]
      },
      "antigravity": {
        "cli": "agy",
        "config_home": "~/.gemini-ag2",
        "skip_permissions": true,
        "include_directories": true,
        "model_rotation": {
          "enabled": true,
          "primary": "",
          "fallback": "Claude Sonnet 4.6 (Thinking)",
          "cooldown_seconds": 900
        }
      },
      "approval": {
        "default_approval_mode": "auto_edit",
        "workspace_agent_yolo_mode": false,
        "enable_permanent_tool_approval": true,
        "auto_add_to_policy_by_default": true,
        "disable_yolo_mode": false,
        "disable_always_allow": false
      }
    },
    "gemini2": {
      "delivery_mode": "gemini",
      "file_inbox": {
        "path": ".llm-inbox/gemini2.md",
        "open_in_vscode": false
      },
      "gemini": {
        "cli": "gemini",
        "config_home": "~/.gemini2-home",
        "env": {
          "GEMINI_CLI_TRUST_WORKSPACE": "true",
          "GOOGLE_GENAI_USE_GCA": "true",
          "GOOGLE_CLOUD_PROJECT": "autotaxi-492811",
          "GOOGLE_CLOUD_PROJECT_ID": "autotaxi-492811",
          "GOOGLE_CLOUD_LOCATION": "us-central1"
        },
        "model": "gemini-2.5-flash-lite",
        "include_directories": true,
        "skip_trust": true,
        "allowed_tools": ["run_shell_command"],
        "extra_include_directories": ["/home/edna/workspace/tenant-commute-hub"]
      },
      "antigravity": {
        "cli": "agy",
        "config_home": "~/.gemini-ag3",
        "skip_permissions": true,
        "include_directories": true,
        "extra_include_directories": [
          "/home/edna/workspace/tenant-commute-hub"
        ],
        "model_rotation": {
          "enabled": true,
          "primary": "",
          "fallback": "Claude Sonnet 4.6 (Thinking)",
          "cooldown_seconds": 900
        }
      },
      "model_preference": {
        "default": "gemini-2.5-flash-lite",
        "gemini2": "gemini-2.5-flash-lite",
        "supported": ["gemini-2.5-flash-lite", "gemini-2.5-flash"]
      },
      "approval": {
        "default_approval_mode": "yolo",
        "workspace_agent_yolo_mode": false,
        "enable_permanent_tool_approval": true,
        "auto_add_to_policy_by_default": true,
        "disable_yolo_mode": false,
        "disable_always_allow": false
      }
    },
    "codex": {
      "delivery_mode": "codex",
      "file_inbox": {
        "path": ".llm-inbox/codex.md",
        "open_in_vscode": false
      },
      "codex": {
        "cli": "codex",
        "model": "gpt-5.6-terra",
        "ask_for_approval": "never",
        "sandbox_mode": "danger-full-access",
        "dangerously_bypass": true
      },
      "approval": {
        "orchestrator_only": true,
        "ask_for_approval": "never",
        "sandbox_mode": "danger-full-access",
        "dangerously_bypass": true
      }
    },
    "codex2": {
      "delivery_mode": "codex",
      "file_inbox": {
        "path": ".llm-inbox/codex2.md",
        "open_in_vscode": false
      },
      "codex": {
        "cli": "codex",
        "config_home": "~/.codex2",
        "model": "gpt-5.6-terra",
        "ask_for_approval": "never",
        "sandbox_mode": "danger-full-access",
        "dangerously_bypass": true
      },
      "approval": {
        "orchestrator_only": true,
        "ask_for_approval": "never",
        "sandbox_mode": "danger-full-access",
        "dangerously_bypass": true
      }
    },
    "copilot": {
      "delivery_mode": "copilot_local",
      "file_inbox": {
        "path": ".llm-inbox/copilot.md",
        "open_in_vscode": false,
        "agent_paths": {
          "copilot": ".llm-inbox/copilot.md"
        }
      },
      "local": {
        "cli": "copilot",
        "autopilot": true,
        "max_autopilot_continues": 12,
        "allow_all_tools": true,
        "add_workspace_dir": true,
        "no_ask_user": true,
        "allow_tools": [],
        "deny_tools": [],
        "extra_args": []
      },
      "model_preference": {
        "default": null,
        "supported": []
      }
    }
  },
  "branch_strategy": {
    "worker_worktrees": {
      "enabled": true,
      "root": ".artifacts/worktrees/auto"
    }
  },
  "ready_dispatcher": {
    "enabled": true,
    "review_statuses": ["review"],
    "owned_statuses": ["in_progress", "todo", "backlog"],
    "dependency_done_statuses": ["done"],
    "worker_terminal_statuses": ["done"],
    "active_worker_statuses": [
      "running",
      "waiting_approval",
      "suspended_approval",
      "retry_backoff",
      "manual_pending",
      "stalled"
    ],
    "helper_claim": {
      "enabled": true,
      "task_statuses": ["backlog", "todo", "in_progress", "review"],
      "availability_first": true,
      "allow_any_idle_lane": true,
      "prefer_assigned_when_idle": true,
      "require_assigned_agent_busy": true,
      "require_owner_higher_priority_load": true
    },
    "max_tasks_per_agent_by_lane": {
      "claude": 1,
      "claude2": 1,
      "codex": 4,
      "codex2": 4,
      "gemini": 2,
      "gemini2": 2,
      "copilot": 2
    },
    "max_dispatches_per_tick": 4,
    "dispatch_cooldown_seconds": 600
  }
}
