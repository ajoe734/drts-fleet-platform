PROJECT_SLUG=drts-fleet-platform
GITHUB_OWNER=REPLACE_ME
REPO_VISIBILITY=private
DEFAULT_BRANCH=main

POSTGRES_DB=drts_fleet_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DEV_INFRA_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drts_fleet_platform

REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

API_PORT=3001
API_HOST=0.0.0.0
TENANT_PORTAL_PORT=3000
PLATFORM_ADMIN_PORT=3002
OPS_CONSOLE_PORT=3003

JWT_SECRET=replace-with-local-dev-secret
JWT_ISSUER=drts-local
JWT_AUDIENCE=drts-api

OPS_ASSISTANT_ENABLED=true
OPS_ASSISTANT_MODEL=claude-opus-4-8
OPS_ASSISTANT_REASONING_MODEL=claude-opus-4-8
OPS_ASSISTANT_CHEAP_MODEL=claude-haiku-4-5
OPS_ASSISTANT_PROMPT_CACHING=true
OPS_ASSISTANT_TIMEOUT_MS=30000
OPS_ASSISTANT_MAX_RETRIES=2
OPS_ASSISTANT_MAX_OUTPUT_TOKENS=1024
OPS_ASSISTANT_TEMPERATURE=0.2
OPS_ASSISTANT_MONTHLY_TOKEN_BUDGET=2000000
OPS_ASSISTANT_VERTEX_PROJECT_ID=
OPS_ASSISTANT_VERTEX_REGION=global
ANTHROPIC_API_KEY=
