PROJECT_SLUG=drts-fleet-platform
GITHUB_OWNER=REPLACE_ME
REPO_VISIBILITY=private
DEFAULT_BRANCH=main

POSTGRES_DB=drts_fleet_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DEV_INFRA_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drts_fleet_platform

REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

API_PORT=3001
API_HOST=0.0.0.0
TENANT_PORTAL_PORT=3000
PLATFORM_ADMIN_PORT=3002
OPS_CONSOLE_PORT=3003

JWT_SECRET=replace-with-local-dev-secret
JWT_ISSUER=drts-local
JWT_AUDIENCE=drts-api
DRTS_ENV=development

MAP_PROVIDER_MODE=mock
MAP_PROVIDER_NAME=google
MAP_PROVIDER_ALLOW_MOCK_IN_PROD=false
MAP_PROVIDER_SERVER_KEY=
MAP_PROVIDER_BROWSER_KEY=
MAP_PROVIDER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
MAP_PROVIDER_MOBILE_BUNDLE_IDS=com.drts.driver
MAP_PROVIDER_MOBILE_PACKAGE_NAMES=com.drts.driver
MAP_PROVIDER_DAILY_QUOTA=100000
MAP_PROVIDER_MINUTE_QUOTA=1000
MAP_PROVIDER_QUOTA_WARNING_PERCENT=80
MAP_PROVIDER_QUOTA_CRITICAL_PERCENT=95
