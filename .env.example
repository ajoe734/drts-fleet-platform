PROJECT_SLUG=drts-fleet-platform
GITHUB_OWNER=REPLACE_ME
REPO_VISIBILITY=private
DEFAULT_BRANCH=main

POSTGRES_DB=drts_fleet_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DEV_INFRA_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drts_fleet_platform

REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

API_PORT=3001
API_HOST=0.0.0.0
TENANT_PORTAL_PORT=3000
PLATFORM_ADMIN_PORT=3002
OPS_CONSOLE_PORT=3003

MAP_PROVIDER_BACKEND=mock
MAP_PROVIDER_MODE=mock
NEXT_PUBLIC_MAP_TILE_URL_TEMPLATE=/mock-map-tiles/{z}/{x}/{y}.svg

JWT_SECRET=replace-with-local-dev-secret
JWT_ISSUER=drts-local
JWT_AUDIENCE=drts-api

# Driver SOS attachment providers (leave provider values empty to fail closed).
DRIVER_SOS_ATTACHMENT_STORAGE_PROVIDER=
DRIVER_SOS_S3_PROVIDER_NAME=s3-compatible
DRIVER_SOS_S3_BUCKET=
DRIVER_SOS_S3_REGION=
DRIVER_SOS_S3_ENDPOINT=
DRIVER_SOS_S3_FORCE_PATH_STYLE=false
DRIVER_SOS_S3_ACCESS_KEY_ID=
DRIVER_SOS_S3_SECRET_ACCESS_KEY=
DRIVER_SOS_S3_SESSION_TOKEN=

DRIVER_SOS_ATTACHMENT_SCANNER_PROVIDER=
DRIVER_SOS_SCANNER_PROVIDER_NAME=https-json-malware-scanner
DRIVER_SOS_SCANNER_URL=
DRIVER_SOS_SCANNER_AUTH_TOKEN=
DRIVER_SOS_SCANNER_TIMEOUT_MS=5000

# Local/test localhost endpoints only; never enables HTTP in production.
DRIVER_SOS_PROVIDER_ALLOW_HTTP_LOCAL=false
