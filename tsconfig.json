{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@drts/contracts": ["packages/contracts/src/index.ts"],
      "@drts/control-plane-auth": ["packages/control-plane-auth/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "playwright.*.config.ts",
    "vitest.config.ts",
    "tests/**/*.ts"
  ]
}
